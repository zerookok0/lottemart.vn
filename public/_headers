/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net https://s.axon.ai; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https:; connect-src 'self' https://annangourmet.makeup wss://annangourmet.makeup https://connect.facebook.net https://www.facebook.com https://s.axon.ai https://*.axon.ai https://b.applovin.com https://b.quantarelay.net https://cm.g.doubleclick.net; frame-src 'self' https://annangourmet.makeup; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: payment=(self), clipboard-write=(self)
  X-DNS-Prefetch-Control: on
  Cross-Origin-Opener-Policy: same-origin-allow-popups

/*.html
  Cache-Control: no-cache, must-revalidate

/checkout
  Cache-Control: no-store
/checkout/
  Cache-Control: no-store
/checkout.html
  Cache-Control: no-store
/order/*
  Cache-Control: no-store

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=600

/bp/*
  Cache-Control: public, max-age=300
/bp/config.json
  Cache-Control: no-store

/favicon.ico
  Cache-Control: public, max-age=604800
